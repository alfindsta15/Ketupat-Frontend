{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://GANTI-NAMA-WORKER.GANTI-SUBDOMAIN.workers.dev/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://GANTI-NAMA-WORKER.GANTI-SUBDOMAIN.workers.dev/uploads/:path*"
    },
    {
      "source": "/((?!api/|uploads/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
